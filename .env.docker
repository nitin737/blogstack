# ============================================
# DOCKER COMPOSE ENVIRONMENT VARIABLES
# ============================================
# This file contains environment variables for Docker Compose
# Copy this to .env and update with your actual values

# Database Configuration
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres

# Spring Profiles
SPRING_PROFILES_ACTIVE=docker

# Service Ports (if you want to customize)
# API_GATEWAY_PORT=8080
# AUTH_SERVICE_PORT=8081
# USER_SERVICE_PORT=8082
# POST_SERVICE_PORT=8083
# COMMENT_SERVICE_PORT=8084
# ENGAGEMENT_SERVICE_PORT=8085
# SUBSCRIPTION_SERVICE_PORT=8086
# NOTIFICATION_SERVICE_PORT=8087
# SEARCH_SERVICE_PORT=8088
# ANALYTICS_SERVICE_PORT=8089
# CONFIG_SERVICE_PORT=8888

# Logging Level
LOGGING_LEVEL=INFO

# JVM Options (optional)
# JAVA_OPTS=-Xmx512m -Xms256m

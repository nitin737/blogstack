# Post Service Local Development Environment Variables
# Copy this file to .env and fill in the actual values

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/post_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-secure-password-here

# Server Configuration
SERVER_PORT=8081

# Auth Service Integration
AUTH_SERVICE_URL=http://localhost:8080

# Spring Profile
SPRING_PROFILES_ACTIVE=local

# Logging
LOGGING_LEVEL_COM_BLOGGING_POST=DEBUG
